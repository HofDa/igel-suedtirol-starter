# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (preferred) or legacy service-role key.
# Never expose this value in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only random secret (at least 32 characters) used to hash rate-limit identifiers.
SUBMISSION_HASH_SALT=

# true: submissions are accepted by the UI but only simulated.
# false: /api/sightings writes to Supabase.
NEXT_PUBLIC_DEMO_MODE=true

# Public base URL, used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Leave empty to use the built-in basemap, which serves official
# tiles from the Autonomous Province of Bolzano geoservice: no API key, no
# third-party CDN, and the authoritative source for the project area.
# Set this only to override that with your own MapLibre style URL — you are
# then responsible for the tile source and its attribution.
# Do NOT point this at https://demotiles.maplibre.org: that is MapLibre's demo
# server, it is not intended for production, and it currently answers HTTP 429.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional secondary reporting route. No link is rendered while empty.
NEXT_PUBLIC_INATURALIST_PROJECT_URL=

# Server-only JSON array of editorially approved rescue contacts.
# Every entry requires editoriallyApproved=true and at least phone, email or website.
HELP_CONTACTS_JSON=
