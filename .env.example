# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this key in client code.
SUPABASE_SERVICE_ROLE_KEY=

# true: submissions are accepted by the UI but only simulated.
# false: /api/sightings writes to Supabase.
NEXT_PUBLIC_DEMO_MODE=true

# Public base URL, used for metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Replace the demo map style before production if required.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
